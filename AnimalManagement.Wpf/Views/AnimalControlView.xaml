<UserControl x:Class="AnimalManagement.Wpf.Views.AnimalControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Button
            Grid.Row="0"
            Height="20"
            Width="75"
            Content="Go back"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="10"
            Command="{Binding NavigateToDashboardCommand}"></Button>
        
        <Button
            Grid.Row="0"
            Height="20"
            Width="75"
            Content="Create"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="10"
            Command="{Binding NavigateToCreateAnimalCommand}"></Button>
        
        <ComboBox
            Grid.Row="0"
            Width="100"
            Height="20"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="10"
            ItemsSource="{Binding Languages}"
            SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
            DisplayMemberPath="Translation"/>
        
        <DataGrid
            Grid.Row="1"
            ItemsSource="{Binding Animals}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            CanUserAddRows="False"
            Margin="15"
            HeadersVisibility="Column"
            GridLinesVisibility="Horizontal"
            Height="175">

            <DataGrid.Columns>
                <DataGridTextColumn
                    Header="Name"
                    Binding="{Binding Name}"
                    Width="*"/>

                <DataGridTextColumn
                    Header="Age"
                    Binding="{Binding Age}"
                    Width="*"/>
                
                <DataGridTextColumn
                    Header="Weight"
                    Binding="{Binding Weight}"
                    Width="*"/>

                <DataGridTextColumn
                    Header="Color"
                    Binding="{Binding Color}"
                    Width="*"/>
                
                <DataGridTextColumn
                    Header="Gender"
                    Binding="{Binding Gender}"
                    Width="*"/>
                
                
            </DataGrid.Columns>
        </DataGrid>
        <Grid
            Grid.Row="2"
            Height="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1"
                    Content="{Binding PreviousPage}"
                    Command="{Binding PreviousPageCommand}"
                    IsEnabled="{Binding CanGoPrevious}"
                    ></Button>
            <Button Grid.Column="2"
                    Content="{Binding CurrentPage}"
            ></Button>
            <Button Grid.Column="3"
                    Content="{Binding NextPage}"
                    Command="{Binding NextPageCommand}"
                    IsEnabled="{Binding CanGoNext}"
            ></Button>
        </Grid>
    </Grid>
</UserControl>
