
<UserControl x:Class="AnimalManagement.Wpf.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:AnimalManagement.Wpf.Infrastructure.Behaviors">

    <Grid Background="#F4F6FA">
        <Border Width="420"
                Padding="35"
                Background="White"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Create Account"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Join Animal Management"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Name" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Padding="8"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Surname" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Padding="8"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Username" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Padding="8"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Password" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding PasswordError}"
                               Foreground="Red"
                               TextWrapping="Wrap"
                               Margin="0,0,0,0"/>
                    <PasswordBox Height="36"
                                 Padding="8"
                                 Margin="0,0,0,10"
                                 behaviors:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}"/>

                    <TextBlock Text="Repeat Password" Margin="0,0,0,5"/>
                    <PasswordBox Height="36"
                                 Padding="8"
                                 Margin="0,0,0,15"
                                 behaviors:PasswordBoxHelper.BoundPassword="{Binding RepeatPassword, Mode=TwoWay}"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="Red"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <Button Content="Create Account"
                            Height="42"
                            FontWeight="SemiBold"
                            Command="{Binding RegisterCommand}"/>

                    <TextBlock HorizontalAlignment="Center"
                               Margin="0,20,0,0">
                        <Run Text="Already have an account? "/>
                        <Hyperlink Command="{Binding NavigateToLoginCommand}">
                            Login
                        </Hyperlink>
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
