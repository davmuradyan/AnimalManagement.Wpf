<UserControl x:Class="AnimalManagement.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F4F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="White"
                Padding="20">

            <DockPanel LastChildFill="False">

                <TextBlock Text="Animal Management"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <ComboBox Width="150"
                          Height="32"
                          ItemsSource="{Binding Languages}"
                          DisplayMemberPath="Translation"
                          SelectedItem="{Binding SelectedLanguage}"
                          VerticalAlignment="Center"
                          DockPanel.Dock="Right"/>

            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="25">

        </Grid>
    </Grid>
</UserControl>